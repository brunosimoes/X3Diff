{
  "name": "x3diff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/vendor-xite.mjs",
    "dev": "vite",
    "prebuild": "node scripts/vendor-xite.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "catalog": "tsx scripts/build-catalog.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests scripts *.ts *.json",
    "benchmark": "tsx scripts/benchmark.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "three": "0.186.1",
    "three-bvh-csg": "0.0.18",
    "three-mesh-bvh": "0.9.7",
    "x_ite": "16.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.8.1",
    "@types/three": "0.186.0",
    "prettier": "3.9.9",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "description": "Local semantic and visual comparison of XML-encoded X3D 3.3 scenes",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brunosimoes/X3Diff.git"
  },
  "homepage": "https://brunosimoes.github.io/X3Diff/"
}
